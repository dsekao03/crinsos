<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="format-detection" content="telephone=no">
<title>배출 시간 계산기</title>
<style>
/* 배치: 시안 그대로. 상단(배출/주기/라인 | 공유/초기화) + 10줄 시간표. 좁은 화면에서는 버튼만 아래로 내림 */
:root{
  color-scheme: light;
  --page:#e9edf3; --sheet:#ffffff; --ink:#111318; --muted:#4a5366; --rule:#111318; --edge:#1f3052;
  --green:#00b050; --yellow:#ffff00; --orange:#ffc000; --purple:#7030a0;
  --blue:#4472c4; --blue-deep:#1d3f7a; --gray:#767676; --red:#e00000; --white:#ffffff;
  --font: "Pretendard", -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
  --cell-h: clamp(42px, 5.4vh, 48px);
}
*{box-sizing:border-box}
body{
  margin:0; background:var(--page); color:var(--ink); font-family:var(--font);
  padding-left:max(16px, env(safe-area-inset-left, 0px));
  padding-right:max(16px, env(safe-area-inset-right, 0px));
  padding-block:16px;
  -webkit-text-size-adjust:100%;
}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.sheet{max-width:640px;margin:0 auto;background:var(--sheet);border:2px solid var(--rule)}

/* ---------- 상단 설정 ---------- */
.top{display:grid;grid-template-columns:minmax(0,1fr) auto;border-bottom:2px solid var(--rule)}
.line-row{display:flex;align-items:center;gap:clamp(6px,2vw,12px);padding:10px clamp(8px,2.5vw,16px);min-height:66px}
.line-row + .line-row{border-top:2px solid var(--rule)}
.label{font-size:clamp(20px,5.6vw,26px);font-weight:500;white-space:nowrap}
.label.second{margin-left:clamp(6px,5vw,40px)}
.actions{display:flex;align-items:center;justify-content:center;gap:14px;padding:12px 18px;border-left:2px solid var(--rule)}

button{font-family:inherit;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.btn{background:var(--blue);color:var(--white);border:1.5px solid var(--edge);border-radius:3px;font-weight:700;font-size:17px;min-height:46px;padding:0 14px}
.btn:hover{filter:brightness(1.08)}
.btn:active{transform:translateY(1px)}
.actions .btn{width:82px;height:74px;padding:0}
.btn.plain{background:var(--white);color:var(--ink)}
.btn.danger{background:var(--red)}
.apply{white-space:nowrap}
.apply.pending{box-shadow:0 0 0 4px var(--orange);animation:pulse 1.2s ease-in-out infinite}
@keyframes pulse{50%{box-shadow:0 0 0 2px var(--orange)}}

.pick{height:var(--cell-h);min-width:clamp(62px,18vw,92px);border:1.5px solid var(--edge);border-radius:2px;font-size:19px;font-weight:700;padding:0 8px;white-space:nowrap}
.pick::after{content:"▾";margin-left:5px;font-size:13px}
.pick.cycle{background:var(--orange);color:var(--ink)}
.pick.lineSel{background:var(--purple);color:var(--white)}

.status{margin:0;padding:9px 14px;font-size:14px;line-height:1.45;color:var(--muted);border-bottom:1px solid #c9d0dc;min-height:45px;display:flex;align-items:center;justify-content:center;text-align:center;word-break:keep-all}

/* ---------- 시간표 ---------- */
.rows{list-style:none;margin:0;padding:14px clamp(8px,3vw,32px) 18px;display:flex;flex-direction:column;gap:10px}
.row{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr) minmax(0,2fr);column-gap:clamp(10px,4.5vw,36px);align-items:center}
.pair{display:grid;grid-template-columns:minmax(0,1fr) 12px minmax(0,1fr);column-gap:clamp(1px,.8vw,5px);align-items:center;min-width:0}
.pair.head{display:flex}
.pair.head .cell{width:clamp(50px,15vw,68px)}
.colon{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:12px}
.colon::before,.colon::after{content:"";width:8px;height:7px;border-radius:50%;background:var(--blue);border:1px solid var(--edge)}

.cell{
  display:block;width:100%;min-width:0;height:var(--cell-h);margin:0;padding:0 2px;
  border:1.5px solid var(--edge);border-radius:2px;
  font-family:inherit;font-size:20px;font-weight:700;text-align:center;font-variant-numeric:tabular-nums;
  background:var(--yellow);color:var(--ink);-webkit-appearance:none;appearance:none;
}
.cell::placeholder{color:currentColor;opacity:.45;font-weight:500;font-size:15px}
.cell.green{background:var(--green)}
.cell.gray{background:var(--gray);color:var(--white)}
.cell.red{background:var(--red);color:var(--white);display:flex;align-items:center;justify-content:center;user-select:text}
.cell::selection{background:var(--blue-deep);color:var(--white)}
input.cell:focus{outline:3px solid var(--blue-deep);outline-offset:1px}
button:focus-visible{outline:3px solid var(--blue-deep);outline-offset:3px}
.pair.manual .cell{border-style:dashed;border-width:2px}
.pair.waiting .cell{background:#ffffb8;border-style:dotted;border-width:2px}

/* ---------- 선택창 ---------- */
dialog{border:2px solid var(--rule);border-radius:10px;padding:18px;width:min(380px, calc(100% - 32px));background:var(--sheet);color:var(--ink);max-height:85%;overflow:auto}
dialog::backdrop{background:rgba(12,18,32,.55)}
dialog h2{margin:0 0 14px;font-size:20px;text-align:center}
dialog p{margin:0 0 16px;text-align:center;line-height:1.55;word-break:keep-all}
.options{display:grid;gap:10px}
.option{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:54px;padding:0 18px;border:1.5px solid var(--edge);border-radius:4px;background:var(--white);color:var(--ink);font-size:20px;font-weight:700}
.option small{font-size:14px;font-weight:500}
.option:hover{background:#eef2fa}
.option[aria-pressed="true"].cycle{background:var(--orange)}
.option[aria-pressed="true"].lineSel{background:var(--purple);color:var(--white)}
.dialog-buttons{display:flex;gap:10px;margin-top:14px}
.dialog-buttons .btn{flex:1;padding:0 6px}
textarea{width:100%;height:240px;resize:vertical;font-family:inherit;font-size:16px;line-height:1.6;font-variant-numeric:tabular-nums;padding:10px;border:1.5px solid var(--edge);border-radius:4px;background:var(--white);color:var(--ink)}

.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom, 0px));width:max-content;max-width:calc(100% - 32px);background:var(--ink);color:var(--white);padding:12px 18px;border-radius:8px;font-size:15px;line-height:1.45;text-align:center;word-break:keep-all;z-index:20;pointer-events:none}

/* ---------- 휴대폰 ---------- */
@media (max-width:599px){
  body{padding-block:10px}
  .top{grid-template-columns:minmax(0,1fr)}
  .actions{border-left:0;border-top:2px solid var(--rule);padding:10px clamp(8px,2.5vw,16px)}
  .actions .btn{flex:1;height:46px}
  .line-row{min-height:62px}
  .apply{padding:0 10px;margin-left:auto}
}
@media (max-width:359px){
  .cell{font-size:18px}
  .pick{font-size:17px;min-width:58px;padding:0 4px}
  .label.second{margin-left:2px}
  .status{min-height:59px}
}
@media (prefers-reduced-motion:reduce){ *{animation:none!important;transition:none!important} }
</style>
</head>
<body>
<main class="sheet">
  <h1 class="sr">배출 시간 계산기</h1>

  <div class="top">
    <div>
      <div class="line-row">
        <span class="label">배출</span>
        <div class="pair head" id="d-pair">
          <input class="cell" id="d-h" type="text" inputmode="numeric" autocomplete="off" enterkeyhint="next" placeholder="시" aria-label="배출 시간(시)">
          <span class="colon" aria-hidden="true"></span>
          <input class="cell" id="d-m" type="text" inputmode="numeric" autocomplete="off" enterkeyhint="done" placeholder="분" aria-label="배출 시간(분)">
        </div>
        <button type="button" class="btn apply" id="apply">설정</button>
      </div>
      <div class="line-row">
        <span class="label">주기</span>
        <button type="button" class="pick cycle" id="cycle-btn" aria-haspopup="dialog">선택</button>
        <span class="label second">라인</span>
        <button type="button" class="pick lineSel" id="line-btn" aria-haspopup="dialog">선택</button>
      </div>
    </div>
    <div class="actions">
      <button type="button" class="btn" id="share-btn">공유</button>
      <button type="button" class="btn" id="reset-btn">초기화</button>
    </div>
  </div>

  <p class="status" id="status" aria-live="polite"></p>
  <ol class="rows" id="rows"></ol>
</main>

<dialog id="pick-dialog" aria-labelledby="pick-title">
  <h2 id="pick-title"></h2>
  <div class="options" id="pick-options"></div>
  <div class="dialog-buttons"><button type="button" class="btn plain" data-close>닫기</button></div>
</dialog>

<dialog id="share-dialog" aria-labelledby="share-title">
  <h2 id="share-title">시간표 공유</h2>
  <textarea id="share-text" readonly aria-label="공유할 내용"></textarea>
  <div class="dialog-buttons">
    <button type="button" class="btn plain" data-close>닫기</button>
    <button type="button" class="btn" id="copy-btn">복사하기</button>
    <button type="button" class="btn" id="send-btn" hidden>보내기</button>
  </div>
</dialog>

<dialog id="reset-dialog" aria-labelledby="reset-title">
  <h2 id="reset-title">모두 지울까요?</h2>
  <p>배출, 주기, 라인, 시간표에 입력한 내용이 모두 지워집니다.</p>
  <div class="dialog-buttons">
    <button type="button" class="btn plain" data-close autofocus>취소</button>
    <button type="button" class="btn danger" id="reset-ok">모두 지우기</button>
  </div>
</dialog>

<div class="toast" id="toast" role="alert" hidden></div>

<script>
(function () {
  'use strict';

  var ROWS = 10;
  var CYCLE_ADD = { 16: 6, 18: 7, 20: 8, 22: 9, 24: 10 };   // 주기별로 더하는 분
  var LINES = ['A', 'B', 'C', 'D'];
  var KEY = 'discharge-time-calc-v1';
  var RANGE_MSG = '시는 00~23, 분은 00~59까지 입력해 주세요.';
  var $ = function (id) { return document.getElementById(id); };

  /* ---------- 시간 계산 (모든 시간은 0시부터의 분으로 저장) ---------- */
  function wrap(min) { return ((min % 1440) + 1440) % 1440; }            // 24시간 표기: 24:00 → 00:00
  function pad(n, len) { return String(n).padStart(len || 2, '0'); }
  function fmt(min) { return min === null ? '--:--' : pad(Math.floor(min / 60)) + ':' + pad(min % 60); }

  function blank() {
    return {
      draft: null,                       // 배출 칸에 입력한 값
      discharge: null,                   // '설정'으로 적용한 배출 값
      cycle: null,
      line: null,
      green: new Array(ROWS).fill(''),
      start: null,                       // 회색 칸
      entered: new Array(ROWS).fill(null), // 둘째 줄부터 오른쪽 칸에 입력한 시간(배출 더하기 전)
      manual: new Array(ROWS).fill(null)   // 왼쪽 칸을 직접 고친 경우
    };
  }

  function calculate() {
    var D = state.discharge;
    var add = state.cycle === null ? null : CYCLE_ADD[state.cycle];
    var first = (state.start !== null && D !== null) ? wrap(state.start + D) : null;
    var out = [{ auto: state.start, left: state.start, right: first }];
    var prev = first;
    for (var i = 1; i < ROWS; i++) {
      var auto = (prev !== null && add !== null) ? wrap(prev + add) : null;  // 윗줄 결과 + 주기 분
      var m = state.manual[i];
      if (m && m.base !== auto) { state.manual[i] = m = null; }              // 위 값이 바뀌면 자동값 우선
      var right = (state.entered[i] !== null && D !== null) ? wrap(state.entered[i] + D) : null; // 입력 + 배출
      out.push({ auto: auto, left: m ? m.v : auto, right: right });
      prev = right;
    }
    return out;
  }

  /* ---------- 저장 / 불러오기 ---------- */
  function isTime(v) { return Number.isInteger(v) && v >= 0 && v < 1440; }
  function load() {
    var s = blank();
    try {
      var raw = JSON.parse(localStorage.getItem(KEY));
      if (!raw) return s;
      ['draft', 'discharge', 'start'].forEach(function (k) { if (isTime(raw[k])) s[k] = raw[k]; });
      if (CYCLE_ADD[raw.cycle]) s.cycle = Number(raw.cycle);
      if (LINES.indexOf(raw.line) >= 0) s.line = raw.line;
      for (var i = 0; i < ROWS; i++) {
        if (raw.green && typeof raw.green[i] === 'string') s.green[i] = raw.green[i];
        if (raw.entered && isTime(raw.entered[i])) s.entered[i] = raw.entered[i];
        var m = raw.manual && raw.manual[i];
        if (m && isTime(m.v) && (m.base === null || isTime(m.base))) s.manual[i] = { v: m.v, base: m.base };
      }
    } catch (e) { /* 저장 공간을 쓸 수 없으면 빈 화면으로 시작 */ }
    return s;
  }
  function save() { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} }

  var state = load();
  var pairs = [];
  var greens = [];

  /* ---------- 알림 ---------- */
  var toastTimer;
  function toast(msg) {
    var t = $('toast');
    t.textContent = msg; t.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { t.hidden = true; }, 2600);
  }

  /* ---------- 공통: 누르면 내용 전체 선택 ---------- */
  function selectOnFocus(el) {
    var typed = false;
    el.addEventListener('focus', function () {
      typed = false;
      el.select();
      setTimeout(function () {
        if (!typed && document.activeElement === el) el.setSelectionRange(0, el.value.length);
      }, 0);
    });
    el.addEventListener('input', function () { typed = true; });
    el.addEventListener('mouseup', function (e) { e.preventDefault(); });
  }

  /* ---------- 시:분 한 쌍 ---------- */
  function timePair(box, hEl, mEl, opt) {
    var editing = false, before = '';
    function show(v) {
      hEl.value = v === null ? '' : pad(Math.floor(v / 60));
      mEl.value = v === null ? '' : pad(v % 60);
    }
    box.addEventListener('focusin', function () {
      if (editing) return;
      editing = true;
      var target = document.activeElement;
      show(opt.editValue());
      before = hEl.value + ':' + mEl.value;
      if (target === hEl || target === mEl) target.select();
      if (opt.onEdit) opt.onEdit();
    });
    box.addEventListener('focusout', function (e) {
      if (box.contains(e.relatedTarget)) return;
      editing = false;
      var h = hEl.value, m = mEl.value;
      if (h + ':' + m === before) { render(); return; }          // 바꾸지 않았으면 그대로 (두 번 더해지지 않음)
      if (h === '' && m === '') { opt.commit(null); update(); return; }
      var hh = Number(h), mm = Number(m);
      if (hh > 23 || mm > 59) { toast(RANGE_MSG); render(); return; }
      opt.commit(hh * 60 + mm); update();
    });
    [hEl, mEl].forEach(function (el) {
      selectOnFocus(el);
      el.addEventListener('input', function (e) {
        var v = el.value.replace(/\D/g, '');
        if (v.length > 2) v = (e.data || '').replace(/\D/g, '').slice(-2) || v.slice(0, 2);
        el.value = v;
        if (v.length < 2) return;
        if (Number(v) > (el === hEl ? 23 : 59)) { toast(RANGE_MSG); el.select(); return; }
        if (el === hEl) mEl.focus(); else el.blur();             // 두 자리를 넣으면 자동으로 다음 칸
      });
      el.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          if (el === hEl) { mEl.focus(); return; }
          el.blur();
          if (opt.onEnter) opt.onEnter();
        } else if (e.key === 'Escape') {
          var parts = before.split(':'); hEl.value = parts[0]; mEl.value = parts[1]; el.blur();
        }
      });
    });
    pairs.push({
      paint: function (calc) {
        if (editing) return;
        var view = opt.view(calc);
        show(view.value);
        box.classList.toggle('manual', !!view.manual);
        box.classList.toggle('waiting', !!view.waiting);
      }
    });
  }

  /* ---------- 시간표 만들기 ---------- */
  function timeInput(id, cls, label, ph) {
    return '<input class="cell ' + cls + '" id="' + id + '" type="text" inputmode="numeric" autocomplete="off" aria-label="' + label + '"' +
      (ph ? ' placeholder="' + ph + '"' : '') + '>';
  }
  var COLON = '<span class="colon" aria-hidden="true"></span>';
  var html = '';
  for (var i = 0; i < ROWS; i++) {
    var n = (i + 1) + '번째 줄 ';
    html += '<li class="row">' +
      '<input class="cell green" id="g-' + i + '" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="done" maxlength="12" aria-label="' + n + '번호"' + (i === 0 ? ' placeholder="번호"' : '') + '>';
    if (i === 0) {
      html += '<div class="pair" id="start-pair">' + timeInput('start-h', 'gray', n + '시작 시', '시') + COLON + timeInput('start-m', 'gray', n + '시작 분', '분') + '</div>' +
        '<div class="pair" id="result-pair"><output class="cell red" id="result-h" aria-label="' + n + '계산 결과 시"></output>' + COLON +
        '<output class="cell red" id="result-m" aria-label="' + n + '계산 결과 분"></output></div>';
    } else {
      html += '<div class="pair" id="l-' + i + '">' + timeInput('l-' + i + '-h', '', n + '왼쪽 시') + COLON + timeInput('l-' + i + '-m', '', n + '왼쪽 분') + '</div>' +
        '<div class="pair" id="r-' + i + '">' + timeInput('r-' + i + '-h', '', n + '오른쪽 시') + COLON + timeInput('r-' + i + '-m', '', n + '오른쪽 분') + '</div>';
    }
    html += '</li>';
  }
  $('rows').innerHTML = html;

  /* 배출 칸 */
  timePair($('d-pair'), $('d-h'), $('d-m'), {
    editValue: function () { return state.draft; },
    view: function () { return { value: state.draft }; },
    commit: function (v) { state.draft = v; },
    onEnter: applyDischarge
  });
  /* 회색 칸 */
  timePair($('start-pair'), $('start-h'), $('start-m'), {
    editValue: function () { return state.start; },
    view: function () { return { value: state.start }; },
    commit: function (v) { state.start = v; }
  });
  /* 둘째 줄부터 */
  for (var r = 1; r < ROWS; r++) (function (i) {
    timePair($('l-' + i), $('l-' + i + '-h'), $('l-' + i + '-m'), {
      editValue: function () { return calculate()[i].left; },
      view: function (c) { return { value: c[i].left, manual: !!state.manual[i] }; },
      commit: function (v) {
        var auto = calculate()[i].auto;
        state.manual[i] = (v === null || v === auto) ? null : { v: v, base: auto };
      }
    });
    timePair($('r-' + i), $('r-' + i + '-h'), $('r-' + i + '-m'), {
      editValue: function () { return state.entered[i]; },       // 고칠 때는 처음 입력한 시간을 보여 줌
      view: function (c) {
        var waiting = state.discharge === null && state.entered[i] !== null;
        return { value: waiting ? state.entered[i] : c[i].right, waiting: waiting };
      },
      commit: function (v) { state.entered[i] = v; },
      onEdit: function () {
        if (state.entered[i] !== null && state.discharge !== null) {
          $('status').textContent = '수정 중: 처음 입력한 시간이 보여요';
        }
      }
    });
  })(r);

  /* ---------- 초록 칸 ---------- */
  for (var g = 0; g < ROWS; g++) (function (i) {
    var el = $('g-' + i), dirty = false;
    greens.push(el);
    selectOnFocus(el);
    el.addEventListener('input', function () { dirty = true; });
    el.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); el.blur(); }
    });
    el.addEventListener('blur', function () {
      if (!dirty) return;
      dirty = false;
      var v = el.value.trim();
      var isNumber = /^\d{1,3}$/.test(v);
      state.green[i] = isNumber ? pad(Number(v), 3) : v;       // 숫자는 세 자리, 글자는 그대로
      if (i === 0 && isNumber) {                               // 맨 위 숫자 → 아래로 +1
        for (var k = 1; k < ROWS; k++) state.green[k] = pad((Number(v) + k) % 1000, 3);
      } else if (i === 0 && /^\d{4,}$/.test(v)) {
        toast('자동 번호는 세 자리(000~999)까지 됩니다.');
      }
      update();
    });
  })(g);

  /* ---------- 화면 그리기 ---------- */
  function statusText() {
    if (state.draft !== state.discharge) return state.draft === null
      ? '설정을 누르면 배출 시간이 지워져요.'
      : '설정을 누르면 적용돼요 (배출 ' + fmt(state.draft) + ')';
    if (state.discharge === null) return '배출 시간을 입력하고 설정을 눌러 주세요.';
    if (state.cycle === null) return '주기를 선택해 주세요.';
    if (state.start === null) return '회색 칸에 시간과 분을 입력해 주세요.';
    return '배출 ' + fmt(state.discharge) + ' 적용 · 주기 ' + state.cycle + ' (다음 줄 +' + CYCLE_ADD[state.cycle] + '분)';
  }
  function render() {
    var c = calculate();
    pairs.forEach(function (p) { p.paint(c); });
    var res = c[0].right;
    $('result-h').textContent = res === null ? '' : pad(Math.floor(res / 60));
    $('result-m').textContent = res === null ? '' : pad(res % 60);
    greens.forEach(function (el, i) { if (el !== document.activeElement) el.value = state.green[i]; });
    $('cycle-btn').textContent = state.cycle === null ? '선택' : state.cycle;
    $('cycle-btn').setAttribute('aria-label', '주기 ' + (state.cycle === null ? '선택' : state.cycle));
    $('line-btn').textContent = state.line === null ? '선택' : state.line + '라인';
    $('apply').classList.toggle('pending', state.draft !== state.discharge);
    $('status').textContent = statusText();
  }
  function update() { calculate(); save(); render(); }

  /* ---------- 버튼 ---------- */
  function commitFocused() {
    var a = document.activeElement;
    if (a && a.tagName === 'INPUT') a.blur();
  }
  function applyDischarge() {
    commitFocused();
    if (state.draft === null && state.discharge === null) { toast('배출 시간을 먼저 입력해 주세요.'); return; }
    state.discharge = state.draft;
    update();
    toast(state.discharge === null ? '배출 시간을 지웠어요.' : '배출 ' + fmt(state.discharge) + ' 설정 완료');
  }
  $('apply').addEventListener('click', applyDischarge);

  function openPicker(title, kind, items, current, choose) {
    commitFocused();
    $('pick-title').textContent = title;
    var box = $('pick-options');
    box.textContent = '';
    var selected = null;
    items.forEach(function (item) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'option ' + kind;
      b.setAttribute('aria-pressed', String(item.value === current));
      var name = document.createElement('span'); name.textContent = item.label; b.appendChild(name);
      if (item.note) { var s = document.createElement('small'); s.textContent = item.note; b.appendChild(s); }
      b.addEventListener('click', function () { choose(item.value); $('pick-dialog').close(); update(); });
      if (item.value === current) selected = b;
      box.appendChild(b);
    });
    $('pick-dialog').showModal();
    (selected || box.firstChild).focus();
  }
  $('cycle-btn').addEventListener('click', function () {
    openPicker('주기 선택', 'cycle', Object.keys(CYCLE_ADD).map(function (k) {
      return { value: Number(k), label: k, note: '+' + CYCLE_ADD[k] + '분' };
    }), state.cycle, function (v) { state.cycle = v; });
  });
  $('line-btn').addEventListener('click', function () {
    openPicker('라인 선택', 'lineSel', LINES.map(function (l) {
      return { value: l, label: l + '라인' };
    }), state.line, function (v) { state.line = v; });
  });

  function shareText() {
    var c = calculate();
    var lines = [
      (state.line ? state.line + '라인' : '라인 미선택') + ' 시간표',
      '배출 ' + fmt(state.discharge) + ' / 주기 ' + (state.cycle === null ? '미선택' : state.cycle),
      ''
    ];
    var count = 0;
    for (var i = 0; i < ROWS; i++) {
      if (c[i].left === null && c[i].right === null) continue;
      lines.push((state.green[i] || '-') + '   ' + fmt(c[i].left) + ' → ' + fmt(c[i].right));
      count++;
    }
    if (!count) lines.push('입력된 시간이 없습니다.');
    return lines.join('\n');
  }
  $('share-btn').addEventListener('click', function () {
    commitFocused();
    $('share-text').value = shareText();
    $('send-btn').hidden = !navigator.share;
    $('share-dialog').showModal();
    $('copy-btn').focus();
    $('share-text').scrollTop = 0;
  });
  $('copy-btn').addEventListener('click', function () {
    var area = $('share-text');
    function fallback() {
      area.focus(); area.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) {}
      alertInDialog(ok ? '복사했어요' : '글을 직접 복사해 주세요');
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(area.value).then(function () { alertInDialog('복사했어요'); }, fallback);
    } else fallback();
  });
  var copyTimer;
  function alertInDialog(msg) {                    // 선택창 위에서는 버튼 글자로 알려 줌
    var b = $('copy-btn');
    b.textContent = msg;
    clearTimeout(copyTimer);
    copyTimer = setTimeout(function () { b.textContent = '복사하기'; }, 2200);
  }
  $('send-btn').addEventListener('click', function () {
    navigator.share({ title: '시간표', text: $('share-text').value }).catch(function (err) {
      if (err && err.name === 'AbortError') return;
      $('send-btn').hidden = true;
      alertInDialog('복사해서 보내 주세요');
    });
  });

  $('reset-btn').addEventListener('click', function () { commitFocused(); $('reset-dialog').showModal(); });
  $('reset-ok').addEventListener('click', function () {
    state = blank();
    $('reset-dialog').close();
    update();
    toast('모두 지웠어요.');
  });

  document.querySelectorAll('dialog').forEach(function (d) {
    d.addEventListener('click', function (e) {
      if (e.target.hasAttribute('data-close')) { d.close(); return; }
      if (e.target !== d) return;
      var b = d.getBoundingClientRect();           // 창 바깥을 누르면 닫기
      if (e.clientX < b.left || e.clientX > b.right || e.clientY < b.top || e.clientY > b.bottom) d.close();
    });
  });

  render();
})();
</script>
</body>
</html>
